{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hunter Account API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Hunter Account Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hunter.io/v2/account"
          },
          "docs": "Returns information about the Hunter account associated with the API key, including usage statistics and plan details. This call is free and does not count toward usage limits."
        }
      ]
    }
  ],
  "bundled": true
}