      "name": "Domain Search",
      "description": {
        "content": "Search for email addresses associated with a domain.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4e3d9197-7f18-4869-ad26-142c7bf1d2cc",
          "name": "Hunter Domain Search",
          "request": {
            "name": "Hunter Domain Search",
            "description": {
              "content": "Returns all the email addresses found using a given domain name, with sources. You must provide either a domain or a company name.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "domain-search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Domain name from which you want to find the email addresses. Required if company is not provided."
                },
                {
                  "disabled": false,
                  "key": "company",
                  "value": "<string>",
                  "description": "Company name from which you want to find the email addresses. Required if domain is not provided."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of email addresses to return. Default is 10."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of email addresses to skip for pagination. Default is 0."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by email address type."
                },
                {
                  "disabled": false,
                  "key": "seniority",
                  "value": "<string>",
                  "description": "Filter by seniority level."
                },
                {
                  "disabled": false,
                  "key": "department",
                  "value": "<string>",
                  "description": "Filter by department."
                },
                {
                  "disabled": false,
                  "key": "verification_status",
                  "value": "<string>",
                  "description": "Filter by verification status."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
