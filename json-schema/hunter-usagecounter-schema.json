{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/UsageCounter",
  "title": "UsageCounter",
  "type": "object",
  "properties": {
    "used": {
      "type": "integer",
      "description": "Number of requests used.",
      "example": 10
