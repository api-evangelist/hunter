{
  "@context": {
    "@vocab": "https://schema.org/",
    "hunter": "https://hunter.io/api/v2#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "vcard": "http://www.w3.org/2006/vcard/ns#",

    "Lead": {
      "@id": "hunter:Lead",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:integer"
        },
        "email": {
          "@id": "schema:email",
          "@type": "xsd:string"
        },
        "first_name": {
          "@id": "schema:givenName",
          "@type": "xsd:string"
        },
        "last_name": {
          "@id": "schema:familyName",
          "@type": "xsd:string"
        },
        "position": {
          "@id": "schema:jobTitle",
          "@type": "xsd:string"
        },
        "company": {
          "@id": "schema:worksFor",
          "@type": "xsd:string"
        },
        "company_industry": {
          "@id": "hunter:companyIndustry",
          "@type": "xsd:string"
        },
        "company_size": {
          "@id": "hunter:companySize",
          "@type": "xsd:string"
        },
        "confidence_score": {
          "@id": "hunter:confidenceScore",
          "@type": "xsd:integer"
        },
        "website": {
          "@id": "schema:url",
          "@type": "@id"
        },
        "country_code": {
          "@id": "schema:addressCountry",
          "@type": "xsd:string"
        },
        "linkedin_url": {
          "@id": "hunter:linkedinUrl",
          "@type": "@id"
        },
        "phone_number": {
          "@id": "schema:telephone",
          "@type": "xsd:string"
        },
        "twitter": {
          "@id": "hunter:twitterHandle",
          "@type": "xsd:string"
        },
        "notes": {
          "@id": "schema:description",
          "@type": "xsd:string"
        },
        "leads_list_id": {
          "@id": "hunter:leadsListId",
          "@type": "xsd:integer"
        },
        "sync_status": {
          "@id": "hunter:syncStatus",
          "@type": "xsd:string"
        },
        "sending_status": {
          "@id": "hunter:sendingStatus",
          "@type": "xsd:string"
        },
        "verification": {
          "@id": "hunter:verification",
          "@type": "hunter:VerificationStatus"
        },
        "last_activity_at": {
          "@id": "hunter:lastActivityAt",
          "@type": "xsd:dateTime"
        },
        "last_contacted_at": {
          "@id": "hunter:lastContactedAt",
          "@type": "xsd:dateTime"
        },
        "created_at": {
          "@id": "schema:dateCreated",
          "@type": "xsd:dateTime"
        }
      }
    },

    "LeadsList": {
      "@id": "hunter:LeadsList",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:integer"
        },
        "name": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "leads_count": {
          "@id": "hunter:leadsCount",
          "@type": "xsd:integer"
        },
        "created_at": {
          "@id": "schema:dateCreated",
          "@type": "xsd:dateTime"
        }
      }
    },

    "DomainSearchResult": {
      "@id": "hunter:DomainSearchResult",
      "@context": {
        "domain": {
          "@id": "hunter:domain",
          "@type": "xsd:string"
        },
        "organization": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "pattern": {
          "@id": "hunter:emailPattern",
          "@type": "xsd:string"
        },
        "emails": {
          "@id": "hunter:emails",
          "@container": "@list"
        }
      }
    },

    "EmailFinderResult": {
      "@id": "hunter:EmailFinderResult",
      "@context": {
        "email": {
          "@id": "schema:email",
          "@type": "xsd:string"
        },
        "score": {
          "@id": "hunter:confidenceScore",
          "@type": "xsd:integer"
        },
        "first_name": {
          "@id": "schema:givenName",
          "@type": "xsd:string"
        },
        "last_name": {
          "@id": "schema:familyName",
          "@type": "xsd:string"
        },
        "domain": {
          "@id": "hunter:domain",
          "@type": "xsd:string"
        },
        "position": {
          "@id": "schema:jobTitle",
          "@type": "xsd:string"
        },
        "company": {
          "@id": "schema:worksFor",
          "@type": "xsd:string"
        }
      }
    },

    "EmailVerifierResult": {
      "@id": "hunter:EmailVerifierResult",
      "@context": {
        "status": {
          "@id": "hunter:verificationStatus",
          "@type": "xsd:string"
        },
        "score": {
          "@id": "hunter:deliverabilityScore",
          "@type": "xsd:integer"
        },
        "email": {
          "@id": "schema:email",
          "@type": "xsd:string"
        },
        "regexp": {
          "@id": "hunter:regexpValid",
          "@type": "xsd:boolean"
        },
        "gibberish": {
          "@id": "hunter:isGibberish",
          "@type": "xsd:boolean"
        },
        "disposable": {
          "@id": "hunter:isDisposable",
          "@type": "xsd:boolean"
        },
        "webmail": {
          "@id": "hunter:isWebmail",
          "@type": "xsd:boolean"
        },
        "mx_records": {
          "@id": "hunter:hasMxRecords",
          "@type": "xsd:boolean"
        },
        "smtp_server": {
          "@id": "hunter:hasSmtpServer",
          "@type": "xsd:boolean"
        },
        "smtp_check": {
          "@id": "hunter:smtpCheckPassed",
          "@type": "xsd:boolean"
        },
        "accept_all": {
          "@id": "hunter:isAcceptAll",
          "@type": "xsd:boolean"
        },
        "block": {
          "@id": "hunter:isBlocked",
          "@type": "xsd:boolean"
        }
      }
    },

    "VerificationStatus": {
      "@id": "hunter:VerificationStatus",
      "@context": {
        "date": {
          "@id": "schema:dateCreated",
          "@type": "xsd:date"
        },
        "status": {
          "@id": "hunter:verificationStatus",
          "@type": "xsd:string"
        }
      }
    },

    "PersonEnrichment": {
      "@id": "hunter:PersonEnrichment",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:string"
        },
        "email": {
          "@id": "schema:email",
          "@type": "xsd:string"
        },
        "location": {
          "@id": "schema:location",
          "@type": "xsd:string"
        },
        "bio": {
          "@id": "schema:description",
          "@type": "xsd:string"
        },
        "avatar": {
          "@id": "schema:image",
          "@type": "@id"
        }
      }
    },

    "CompanyEnrichment": {
      "@id": "hunter:CompanyEnrichment",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:string"
        },
        "name": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "legalName": {
          "@id": "schema:legalName",
          "@type": "xsd:string"
        },
        "domain": {
          "@id": "hunter:domain",
          "@type": "xsd:string"
        },
        "description": {
          "@id": "schema:description",
          "@type": "xsd:string"
        },
        "foundedYear": {
          "@id": "schema:foundingDate",
          "@type": "xsd:integer"
        },
        "location": {
          "@id": "schema:location",
          "@type": "xsd:string"
        },
        "logo": {
          "@id": "schema:logo",
          "@type": "@id"
        },
        "phone": {
          "@id": "schema:telephone",
          "@type": "xsd:string"
        }
      }
    },

    "Campaign": {
      "@id": "hunter:Campaign",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:integer"
        },
        "name": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "recipients_count": {
          "@id": "hunter:recipientsCount",
          "@type": "xsd:integer"
        },
        "started": {
          "@id": "hunter:isStarted",
          "@type": "xsd:boolean"
        },
        "archived": {
          "@id": "hunter:isArchived",
          "@type": "xsd:boolean"
        },
        "paused": {
          "@id": "hunter:isPaused",
          "@type": "xsd:boolean"
        },
        "created_at": {
          "@id": "schema:dateCreated",
          "@type": "xsd:dateTime"
        }
      }
    },

    "Source": {
      "@id": "hunter:Source",
      "@context": {
        "domain": {
          "@id": "hunter:sourceDomain",
          "@type": "xsd:string"
        },
        "uri": {
          "@id": "schema:url",
          "@type": "@id"
        },
        "extracted_on": {
          "@id": "hunter:extractedOn",
          "@type": "xsd:date"
        },
        "last_seen_on": {
          "@id": "hunter:lastSeenOn",
          "@type": "xsd:date"
        },
        "still_on_page": {
          "@id": "hunter:stillOnPage",
          "@type": "xsd:boolean"
        }
      }
    }
  }
}
