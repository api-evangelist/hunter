{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "Campaign",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "recipients_count": {
      "type": "integer"
    },
    "editable": {
      "type": "boolean"
    },
    "started": {
      "type": "boolean"
    },
    "archived": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "sending_status": {
      "type": "['string', 'null']"
    },
    "created_at": {
      "type": "string"
    }
  }
}